# Oddify Exchange — Environment Variables

# Server
PORT=3000

# Blockchain
POLYGON_RPC=https://polygon-rpc.com
PRIVATE_KEY=your_deployer_private_key
USDC_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174  # USDC on Polygon
FACTORY_ADDRESS=  # set after deploying MarketFactory
DEFAULT_FEE_BPS=100  # 1%

# Binance Oracle
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# Database (Supabase free tier)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# API
API_RATE_LIMIT=100  # requests per minute for free tier
