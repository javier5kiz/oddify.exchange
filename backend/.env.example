# Oddify Exchange — Environment Variables

# Server
PORT=3000

# Blockchain (Polygon Amoy Testnet)
POLYGON_RPC=https://rpc-amoy.polygon.technology
PRIVATE_KEY=your_deployer_private_key_here
USDC_ADDRESS=0x1c7D4B196Cb0C7B0d8F9F2C5C5C5C5C5C5C5C5C5  # testnet USDC — update after deploy
FACTORY_ADDRESS=  # set after deploying MarketFactory
DEFAULT_FEE_BPS=100  # 1%

# Binance Oracle
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# Database (Supabase free tier)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# API
API_RATE_LIMIT=100  # requests per minute for free tier

# Wallet support (informational — wallets are detected client-side)
# Supported: MetaMask, Phantom (EVM), Trust Wallet
# All three use EIP-1193 provider injection
