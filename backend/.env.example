# Oddify Exchange — Environment Variables

# Server
PORT=3000

# Blockchain (leave empty for off-chain mode — set after deploying contracts)
POLYGON_RPC=https://polygon-amoy.drpc.org
PRIVATE_KEY=
USDC_ADDRESS=
FACTORY_ADDRESS=

# Binance Oracle
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# Database (Supabase — optional, set up later)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Platform fee (in basis points, 100 = 1%)
DEFAULT_FEE_BPS=100
